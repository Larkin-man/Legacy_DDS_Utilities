@echo off
chcp 65001 >nul
cd /d "%~dp0"

:: Создаем папку Out, если её еще нет
if not exist Out mkdir Out

echo Начинаем распаковку DDS в PNG (вывод в папку Out)...
echo -------------------------------------------------------

for %%i in (*.dds) do (
    echo Распаковка: %%~nxi
    magick.exe "%%i" "Out\%%~ni.png"
)

echo -------------------------------------------------------
echo Распаковка завершена! Все файлы сохранены в папку Out.
pause
