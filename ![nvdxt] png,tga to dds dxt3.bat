@echo off
:: Переходим в папку, где лежит сам батник
cd /d "%~dp0"

echo Начинаем конвертацию PNG и TGA в формат DDS DXT3 с мип-мапами...
echo -------------------------------------------------------------------

for %%i in (*.png *.tga) do (
    echo Обработка файла: %%~nxi
    nvdxt.exe -file "%%i" -dxt3
)

echo -------------------------------------------------------------------
echo Конвертация завершена!
pause
