@echo off
chcp 65001 >nul
:: Переходим в папку, где лежит сам батник
cd /d "%~dp0"

echo Начинаем конвертацию PNG и TGA в формат DDS DXT1...
echo -------------------------------------------------------------------

for %%i in (*.png *.tga) do (
    echo Обработка файла: %%~nxi
    nvdxt.exe -file "%%i" -dxt1a -nomipmap -outdir Out
)

echo -------------------------------------------------------------------
echo Конвертация завершена!
pause