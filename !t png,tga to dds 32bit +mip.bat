@echo off
chcp 65001 >nul
cd /d "%~dp0"

echo Начинаем конвертацию ТЕКСТУР PNG,TGA в DDS 32bitargb, полные мип-мапы...
echo -------------------------------------------------------------------

for %%i in (*.png *.tga) do (
    echo Обработка текстуры: %%~nxi
    texconv.exe "%%i" -nologo -f BC3_UNORM -y -o "Out"
)

echo -------------------------------------------------------------------
echo Конвертация текстур завершена!
pause