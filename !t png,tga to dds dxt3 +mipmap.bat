@echo off
chcp 65001 >nul
cd /d "%~dp0"

echo Начинаем конвертацию ТЕКСТУР (PNG/TGA -> DDS DXT3, полные мип-мапы)...
echo -------------------------------------------------------------------

for %%i in (*.png *.tga) do (
    echo Обработка текстуры: %%~nxi
    texconv.exe "%%i" -f BC2_UNORM -y >nul
)

echo -------------------------------------------------------------------
echo Конвертация текстур завершена!
pause
