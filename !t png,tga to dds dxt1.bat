@echo off
chcp 65001 >nul
cd /d "%~dp0"

echo Начинаем конвертацию ИКОНОК PNG в DDS DXT1, без мип-мапов...
echo ---------------------------------------------------------------

for %%i in (*.png *.tga) do (
    echo Обработка иконки: %%~nxi
    texconv.exe "%%i" -nologo -f BC1_UNORM -m 1 -y -o "Out"
)

echo ---------------------------------------------------------------
echo Конвертация иконок завершена!
pause