@echo off
chcp 65001 >nul
cd /d "%~dp0"

echo Начинаем конвертацию ИКОНОК (PNG -> DDS DXT1, без мип-мапов)...
echo ---------------------------------------------------------------

for %%i in (*.png *.tga) do (
    echo Обработка иконки: %%~nxi
    texconv.exe "%%i" -f BC1_UNORM -m 1 -y >nul
)

echo ---------------------------------------------------------------
echo Конвертация иконок завершена!
pause
