@echo off
chcp 65001 >nul
cd /d "%~dp0"

if not exist texdiag.exe (
    echo ОШИБКА: texdiag.exe не найден!
    pause
    exit
)

title Сбор информации о PNG, TGA

set "LOG=_diag_info.txt"

echo Сбор информации о PNG, TGA...

echo ============================================================ > "%LOG%"
echo  Информация о PNG файлах >> "%LOG%"
echo ============================================================ >> "%LOG%"

texdiag.exe info *.png >> "%LOG%" 2>&1

echo ============================================================ >> "%LOG%"
echo  Информация о TGA файлах >> "%LOG%"
echo ============================================================ >> "%LOG%"

texdiag.exe info *.tga >> "%LOG%" 2>&1

echo ============================================================ >> "%LOG%"
echo Готово! >> "%LOG%"
echo ============================================================ >> "%LOG%"

echo.
echo Информация сохранена в %LOG%
echo.
echo Нажмите любую клавишу для открытия файла...
pause >nul

start notepad++.exe "%LOG%"